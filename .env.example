# Copy to .env and fill in. Real values NEVER get committed (ADR-027).
SUPABASE_URL=
SUPABASE_ANON_KEY=            # dashboard → Settings → API (safe for the app)
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
USDA_API_KEY=                 # P1-06 full seed pending — pipeline ready, runs the moment a key is set
EXPO_PUBLIC_SUPABASE_URL=        # same as SUPABASE_URL (Expo-exposed)
EXPO_PUBLIC_SUPABASE_ANON_KEY=   # same as anon key (safe for client)
